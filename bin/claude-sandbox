#!/usr/bin/env bash
set -euo pipefail

# Run Claude Code inside an isolated zotavm microVM.
#
# Usage:
#   claude-sandbox [options] [-- claude-args...]
#
# Options:
#   -d, --dir <path>   Host directory to use (default: current directory)
#   -i, --id <id>      Use an existing VM by ID (skip create)
#   --cpus <n>          vCPUs for new VM (default: smolvm default)
#   --mem <MiB>         Memory for new VM (default: smolvm default)
#   --destroy           Destroy the VM after claude exits
#   -h, --help          Show this help
#
# If no --id is given, a new VM is created from the directory.
# Claude args after -- are forwarded to claude inside the VM.

ZOTAVM="zotavm"
DIR="$(pwd)"
VM_ID=""
CPUS=""
MEM=""
DESTROY=false
CLAUDE_ARGS=()

show_help() {
  sed -n '3,17p' "$0" | sed 's/^# \?//'
  exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)    show_help ;;
    -d|--dir)     DIR="$2"; shift 2 ;;
    -i|--id)      VM_ID="$2"; shift 2 ;;
    --cpus)       CPUS="$2"; shift 2 ;;
    --mem)        MEM="$2"; shift 2 ;;
    --destroy)    DESTROY=true; shift ;;
    --)           shift; CLAUDE_ARGS=("$@"); break ;;
    *)            CLAUDE_ARGS=("$@"); break ;;
  esac
done

DIR="$(cd "$DIR" && pwd)"

cleanup() {
  if [[ -n "$VM_ID" ]]; then
    if [[ "$DESTROY" == true ]]; then
      "$ZOTAVM" destroy "$VM_ID" &>/dev/null || true
    else
      "$ZOTAVM" stop "$VM_ID" &>/dev/null || true
    fi
  fi
}
trap cleanup EXIT

# If no VM ID provided, create a new VM from the directory
if [[ -z "$VM_ID" ]]; then
  CREATE_ARGS=("$DIR")
  [[ -n "$CPUS" ]] && CREATE_ARGS+=(--cpus "$CPUS")
  [[ -n "$MEM" ]]  && CREATE_ARGS+=(--mem "$MEM")

  CREATE_OUTPUT="$("$ZOTAVM" create "${CREATE_ARGS[@]}" 2>&1)"

  # Extract VM ID from "VM ready: <name> (<id>)"
  VM_ID="$(echo "$CREATE_OUTPUT" | grep -oE '\([a-f0-9]+\)' | head -1 | tr -d '()')"

  if [[ -z "$VM_ID" ]]; then
    echo "Error: Failed to create VM" >&2
    echo "$CREATE_OUTPUT" >&2
    exit 1
  fi
fi

# Build claude command with args — skip permissions since it's sandboxed
CLAUDE_CMD="CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=true claude --dangerously-skip-permissions"
if [[ ${#CLAUDE_ARGS[@]} -gt 0 ]]; then
  for arg in "${CLAUDE_ARGS[@]}"; do
    CLAUDE_CMD+=" '${arg//\'/\'\\\'\'}'"
  done
fi

# Run claude interactively inside the VM via zotavm shell
"$ZOTAVM" shell "$VM_ID" -- $CLAUDE_CMD
